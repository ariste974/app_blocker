{
  "name": "app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.118.0",
    "expo": "~58.0.22",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.14",
    "expo-dev-client": "~58.0.18",
    "expo-linking": "~58.0.15",
    "expo-notifications": "~58.1.7",
    "expo-router": "~58.0.29",
    "expo-status-bar": "~58.0.4",
    "expo-web-browser": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-device-activity": "^0.6.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "supabase": "^2.122.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --go",
    "start:dev-client": "expo start --dev-client",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests",
    "test:quiz": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/quiz.test.mjs",
    "build": "expo export --platform web",
    "prebuild:ios": "expo prebuild --platform ios",
    "build:ios:development": "eas build --platform ios --profile development"
  },
  "private": true
}
